# ─────────────────────────────────────────────────────────────────────────────
# Server environment variables — copy to server/.env and fill in your values,
# OR set them in the Railway dashboard under  Project → Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway Postgres add-on, etc.)
EXTERNAL_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# MongoDB connection string (MongoDB Atlas or Railway MongoDB add-on)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=yourapp

# ── Security ──────────────────────────────────────────────────────────────────
# Required: secret key used to sign JWT tokens for admin authentication.
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your-random-secret-here

# ── LLM / AI providers ────────────────────────────────────────────────────────
# Set the LLM provider your agents use by default
LLM_PROVIDER=openai          # openai | anthropic | local | pwc_genai

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# ── Observability (Langfuse) ──────────────────────────────────────────────────
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Zoho workflow agents (optional) ───────────────────────────────────────────
# Transport is auto-selected from ZOHO_BACKEND when set, else from ZOHO_MCP_URL.
# Set only one method block below.

# Method A: Zoho MCP connection. With "Authorization via Connection" enabled in
# the Zoho MCP console, the connection is pre-authorized for the services it
# contains, so no OAuth keys are needed.
ZOHO_MCP_URL=
# Optional tool pins only if auto-resolution picks the wrong tool names.
#   ZOHO_MCP_TOOL_MAIL_SEND=zohomail_send_email
#   ZOHO_MCP_TOOL_CALENDAR_CREATE_EVENT=zoho_add_event

# Method B: direct Zoho REST APIs. One OAuth app in https://api-console.zoho.com
# covers Mail, Calendar, Projects, Desk and Cliq. Generate the refresh token with
# access_type=offline.
# Leave unset for URL-based autodetection, or explicitly choose mcp or rest.
# ZOHO_BACKEND=mcp
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# REST only. Account region, and therefore every Zoho product host:
# us, eu, in, au, jp, ca, cn, sa
ZOHO_DC=us
# REST only. Direct override of the accounts host, e.g. https://accounts.zoho.eu
ZOHO_ACCOUNTS_BASE_URL=
# REST only, required for Zoho Desk (Desk > Setup > Developer Space > API)
ZOHO_ORG_ID=
# Shared routing defaults. Use real IDs from the connected account.
ZOHO_CALENDAR_ID=
ZOHO_PROJECTS_PORTAL_ID=
ZOHO_PROJECTS_PROJECT_ID=
ZOHO_CLIQ_CHANNEL=
# REST only: optional webhook and Desk department filter.
ZOHO_CLIQ_WEBHOOK_URL=
ZOHO_DESK_DEPARTMENT_ID=
ZOHO_FROM_ADDRESS=
ZOHO_TIMEZONE=Asia/Kolkata
ZOHO_MEETING_DURATION_MINUTES=30
# Safety: writes are planned but not executed until dry run is off AND writes are confirmed.
ZOHO_DRY_RUN=true
ZOHO_CONFIRM_WRITES=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Agent / stream tuning ─────────────────────────────────────────────────────
LLM_SEMAPHORE_LIMIT=50
AGENT_STREAM_TIMEOUT_SEC=3000
AGENT_STREAM_MAX_DURATION_SEC=3000
AGENT_STREAM_IDLE_TIMEOUT_SEC=3000
AGENT_STREAM_HEARTBEAT_SEC=15
BACKPRESSURE_PER_USER=3

# ── DB connection pool ────────────────────────────────────────────────────────
CHAT_DB_POOL_MIN=5
CHAT_DB_POOL_MAX=20
CHAT_DB_STMT_TIMEOUT_MS=30000

# ── MCP ───────────────────────────────────────────────────────────────────────
MCP_STREAMABLE_STATELESS=1

# ── Claude code-review (optional) ─────────────────────────────────────────────
CLAUDE_CODE_REVIEW_TARGET_SCORE=90
CLAUDE_CODE_REVIEW_MAX_LOOPS=3
CLAUDE_CODE_REVIEW_ENABLED=true
